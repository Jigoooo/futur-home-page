{
  "name": "futur-home-page-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode dev",
    "build": "tsc -b && vite build",
    "start": "node .output/server/index.mjs",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "assets:project-records": "node scripts/generate-project-record-images.mjs",
    "preview": "vite preview --port 3010",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "PATH=\"$HOME/Library/pnpm:$HOME/.nvm/versions/node/v24.13.0/bin:$PATH\" pnpm exec lint-staged"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@tanstack/react-router": "1.170.8",
    "@tanstack/react-start": "1.168.13",
    "gsap": "^3.15.0",
    "lucide-react": "^1.16.0",
    "nitro": "3.0.260522-beta",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "9.39.1",
    "@playwright/test": "^1.60.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tanstack/eslint-plugin-router": "1.162.0",
    "@tanstack/router-plugin": "1.168.11",
    "@types/node": "25.9.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.6.0",
    "lint-staged": "^17.0.5",
    "playwright": "^1.60.0",
    "prettier": "3.8.3",
    "simple-git-hooks": "^2.13.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.60.0",
    "vite": "8.0.14",
    "wait-on": "^9.0.10"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
